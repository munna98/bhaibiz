# -----------------------------------------------------------------------------
# BhaiBiz Environment Configuration
# -----------------------------------------------------------------------------

# Supabase Client (Browser & Server)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Supabase Server-side (SSR & API routes)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database Connection (for Drizzle migrations)
# Direct connection string to PostgreSQL (e.g. Supabase connection pooling or direct port 5432)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Worker Aadhaar Encryption (AES-GCM key secret for src/lib/workers.functions.ts)
AADHAAR_KEY=""

# Application URL (used in email confirmation links)
APP_URL="https://bhaibiz.com"

# Resend Email Configuration
RESEND_API_KEY=""
RESEND_FROM_EMAIL="BhaiBiz <noreply@noreplay.bhaibiz.com>"
